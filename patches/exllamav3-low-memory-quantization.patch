+def block_trace_pair_stream(weight, weight_q, H, device, col_block = 8192):
+    """Compute proxy-error numerator/denominator without materializing a full error tensor."""
+    num = 0.0
+    den = 0.0
+    for start in range(0, weight.shape[1], col_block):
+        end = min(start + col_block, weight.shape[1])
+        W = weight[:, start:end].to(device)
+        Q = weight_q[:, start:end].to(device)
+        E = W - Q
+        num += block_trace(E, H)
+        den += block_trace(W, H)
+        del E, Q, W
+    return num, den
