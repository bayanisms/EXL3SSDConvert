+def _mmap_zeros(shape, dtype, directory):
+    """Create an unlinked, file-backed CPU tensor initialized to zero."""
+    os.makedirs(directory, exist_ok = True)
+    numel = math.prod(shape)
+    element_size = torch.empty((), dtype = dtype).element_size()
+    fd, path = tempfile.mkstemp(prefix = "exl3-quant-", suffix = ".mmap", dir = directory)
+    try:
+        os.ftruncate(fd, numel * element_size)
+    finally:
+        os.close(fd)
+    try:
+        tensor = torch.from_file(path, shared = True, size = numel, dtype = dtype).view(shape)
+        os.unlink(path)
+        return tensor
+    except BaseException:
+        try:
+            os.unlink(path)
+        except FileNotFoundError:
+            pass
+        raise
+
+
+def _large_cpu_zeros(shape, dtype, device):
+    """Use reclaimable file-backed storage for large conversion buffers when requested."""
+    directory = os.environ.get("EXL3_QUANT_MMAP_DIR")
+    threshold = int(os.environ.get("EXL3_QUANT_MMAP_THRESHOLD", str(1 << 30)))
+    nbytes = math.prod(shape) * torch.empty((), dtype = dtype).element_size()
+    if directory and torch.device(device).type == "cpu" and nbytes >= threshold:
+        return _mmap_zeros(shape, dtype, directory)
+    return torch.zeros(shape, dtype = dtype, device = device)
